/* pages/patient/home/home.wxss */
.page-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
}

.header-bar {
  background: #4A90E2;
  padding: 60rpx 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.3);
  border: 2rpx solid rgba(255,255,255,0.5);
}

.welcome {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.sub-welcome {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.notify-btn {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notify-icon { font-size: 36rpx; }

.notify-dot {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #E24B4A;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.content-scroll {
  flex: 1;
  padding-top: 24rpx;
}

/* 上次评估卡 */
.status-card .card-title { margin-bottom: 16rpx; }

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: #4A90E2;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.card-title text:first-of-type {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.see-all {
  font-size: 24rpx;
  color: #4A90E2;
}

.last-assess-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.last-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #E6F1FB;
  flex-shrink: 0;
}

.last-info {
  flex: 1;
}

.last-date {
  font-size: 24rpx;
  color: #8A9BB0;
  margin-bottom: 10rpx;
}

.last-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.last-metrics {
  font-size: 24rpx;
  color: #5F5E5A;
  display: flex;
  gap: 20rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: #B4B2A9;
  font-weight: 300;
}

/* 上传区 */
.upload-card { padding-bottom: 32rpx; }

.upload-zone {
  border: 3rpx dashed #B5D4F4;
  border-radius: 20rpx;
  background: #F5F9FF;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.upload-zone-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

.upload-circle {
  width: 120rpx;
  height: 120rpx;
  background: #E6F1FB;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.camera-icon { font-size: 52rpx; }

.upload-main-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #4A90E2;
  margin-bottom: 10rpx;
}

.upload-sub-text {
  font-size: 24rpx;
  color: #8A9BB0;
  text-align: center;
}

.media-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.media-preview-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.media-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background: #E6F1FB;
}

.media-type-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #fff;
}

.badge-image { background: rgba(74,144,226,0.8); }
.badge-video { background: rgba(29,158,117,0.8); }

.media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 20rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-add-more {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 3rpx dashed #B5D4F4;
  background: #F5F9FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-icon {
  font-size: 60rpx;
  color: #4A90E2;
  font-weight: 300;
}

.media-hint {
  font-size: 24rpx;
  color: #8A9BB0;
  margin-bottom: 24rpx;
}

.form-item { margin-bottom: 32rpx; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: #5F5E5A;
  margin-bottom: 14rpx;
}

.symptom-input {
  width: 100%;
  min-height: 120rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A2332;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #B4B2A9;
  margin-top: 8rpx;
}

.submit-btn { margin-top: 8rpx; }

.btn-disabled {
  background: #B5D4F4 !important;
  color: rgba(255,255,255,0.7) !important;
}

.analyzing-banner {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #E1F5EE;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.analyzing-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #9FE1CB;
  border-top-color: #0F6E56;
  border-radius: 20rpx;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes spin { to { transform: rotate(360deg); } }

.analyzing-info {
  flex: 1;
}

.analyzing-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #0F6E56;
}

.analyzing-sub {
  display: block;
  font-size: 22rpx;
  color: #1D9E75;
  margin-top: 4rpx;
}

.analyzing-link {
  font-size: 24rpx;
  color: #0F6E56;
  text-decoration: underline;
}

/* 引导入口 */
.guide-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.guide-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guide-icon { font-size: 44rpx; }

.guide-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2332;
}

.guide-desc {
  display: block;
  font-size: 24rpx;
  color: #8A9BB0;
  margin-top: 6rpx;
}

/* 护理提示 */
.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.tip-dot {
  font-size: 32rpx;
  color: #4A90E2;
  line-height: 1.4;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.6;
}

/* 进度弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 560rpx;
  max-width: 90vw;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 36rpx;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #E6F1FB;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #4A90E2;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #4A90E2;
  width: 70rpx;
  text-align: right;
}

.progress-stage {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #8A9BB0;
  margin-bottom: 8rpx;
}
