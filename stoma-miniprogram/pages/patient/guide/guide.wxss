/* pages/patient/guide/guide.wxss */
.guide-page { background: #F5F7FA; min-height: 100vh; }

.guide-hero {
  background: #4A90E2;
  padding: 48rpx 32rpx 60rpx;
  text-align: center;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #fff;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.step-list { padding: 24rpx 24rpx 0; }

.step-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(74,144,226,0.08);
}

.step-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  background: #4A90E2;
  border-radius: 24rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2332;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #5F5E5A;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.tip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #1A2332;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  background: #E1F5EE;
  color: #0F6E56;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
}

.step-warn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FAEEDA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #854F0B;
}

.warn-icon {
  width: 32rpx;
  height: 32rpx;
  background: #EF9F27;
  color: #fff;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.angle-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.angle-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
}

.angle-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.angle-icon {
  font-size: 36rpx;
  color: #4A90E2;
}

.angle-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2332;
  margin-bottom: 4rpx;
}

.angle-desc {
  font-size: 22rpx;
  color: #8A9BB0;
}

.faq-item {
  border-bottom: 1px solid rgba(74,144,226,0.1);
  padding: 20rpx 0;
}

.faq-item:last-child { border-bottom: none; }

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.faq-q-text {
  font-size: 28rpx;
  color: #1A2332;
  flex: 1;
  line-height: 1.5;
}

.faq-arrow {
  font-size: 24rpx;
  color: #8A9BB0;
  margin-left: 16rpx;
}

.faq-a {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.7;
  background: #F5F7FA;
  padding: 20rpx;
  border-radius: 12rpx;
}

.bottom-btn-wrap {
  padding: 24rpx 24rpx 0;
}
