/* pages/doctor/list/list.wxss */
.page-wrap { background: #F5F7FA; min-height: 100vh; display: flex; flex-direction: column; }

.doc-header {
  background: #0F6E56;
  padding: 56rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.doc-greeting { display: block; font-size: 32rpx; font-weight: 500; color: #fff; }
.doc-sub { display: block; font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 6rpx; }

.stats-mini {
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  text-align: center;
}

.stats-num { display: block; font-size: 40rpx; font-weight: 500; color: #fff; }
.stats-label { display: block; font-size: 22rpx; color: rgba(255,255,255,0.75); }

.filter-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid rgba(29,158,117,0.1);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.f-tab {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #8A9BB0;
  background: #F5F7FA;
}

.f-tab.active { background: #E1F5EE; color: #0F6E56; font-weight: 500; }

.urgency-filter { display: flex; gap: 12rpx; }

.uf-item {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #8A9BB0;
  background: #F5F7FA;
}

.uf-item.active { background: #1D9E75; color: #fff; }

.pending-item {
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(15,110,86,0.08);
}

.urgency-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.urgency-high { background: #E24B4A; }
.urgency-medium { background: #EF9F27; }
.urgency-low { background: #1D9E75; }

.pi-body { flex: 1; padding: 24rpx 24rpx 20rpx; }

.pi-top { display: flex; gap: 16rpx; margin-bottom: 16rpx; }

.pi-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #E1F5EE;
  flex-shrink: 0;
}

.pi-info { flex: 1; }

.pi-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pi-name { font-size: 30rpx; font-weight: 500; color: #1A2332; }

.pi-time {
  display: block;
  font-size: 23rpx;
  color: #8A9BB0;
  margin-bottom: 8rpx;
}

.pi-desc {
  display: block;
  font-size: 25rpx;
  color: #5F5E5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 440rpx;
}

.ai-pre-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 16rpx;
}

.ai-badge {
  background: #4A90E2;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.ai-pre-text {
  flex: 1;
  font-size: 25rpx;
  color: #5F5E5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pi-actions { display: flex; gap: 16rpx; }

.action-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.btn-detail {
  background: #E1F5EE;
  color: #0F6E56;
  border: 2rpx solid #9FE1CB;
}

.btn-quick {
  background: #1D9E75;
  color: #fff;
}

/* 悬浮操作栏 */
.float-action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
}
.fab-switch {
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
}
.fab-logout {
  background: #E24B4A;
}
.fab-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.fab-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
  text-align: center;
}
