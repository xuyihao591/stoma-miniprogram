<!-- pages/doctor/stats/stats.wxml -->
<view class="stats-page">
  <!-- 悬浮操作栏 -->
  <view class="float-action-bar">
    <view class="fab-btn fab-switch" bindtap="switchRole">
      <text class="fab-icon">🔄</text>
      <text class="fab-text">切换</text>
    </view>
    <view class="fab-btn fab-logout" bindtap="logout">
      <text class="fab-icon">🚪</text>
      <text class="fab-text">退出</text>
    </view>
  </view>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" style="height:100vh">
    <!-- 总览卡片 -->
    <view class="overview-section">
      <text class="ov-title">工作统计</text>
      <view class="ov-grid">
        <view class="ov-item" wx:for="{{overviewItems}}" wx:key="index">
          <text class="ov-num">{{item.value}}</text>
          <text class="ov-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 本周处理量 -->
    <view class="card">
      <view class="card-title">
        <view class="card-title-bar" style="background:#1D9E75"></view>
        <text>本周处理量</text>
      </view>
      <canvas type="2d" id="weekCanvas" style="width:100%;height:360rpx"/>
    </view>

    <!-- 感染分布 -->
    <view class="card">
      <view class="card-title">
        <view class="card-title-bar" style="background:#1D9E75"></view>
        <text>感染等级分布</text>
      </view>
      <view class="severity-dist">
        <view class="dist-item" wx:for="{{severityDist}}" wx:key="index">
          <view class="dist-bar-wrap">
            <view class="dist-bar" style="width:{{item.percent}}%;background:{{item.color}}"></view>
          </view>
          <text class="dist-label">{{item.label}}</text>
          <text class="dist-val">{{item.count}} ({{item.percent}}%)</text>
        </view>
      </view>
    </view>

    <!-- 处理时效 -->
    <view class="card">
      <view class="card-title">
        <view class="card-title-bar" style="background:#1D9E75"></view>
        <text>平均处理时效</text>
      </view>
      <view class="avg-time-row">
        <text class="avg-time-num">{{avgResponseMinutes}}</text>
        <text class="avg-time-unit">分钟</text>
        <text class="avg-time-hint">{{avgHint}}</text>
      </view>
    </view>

    <view style="height:60rpx"></view>
  </scroll-view>
</view>
