/* pages/doctor/stats/stats.wxss */
.stats-page { background: #F5F7FA; }
.overview-section { background: #0F6E56; padding: 32rpx; margin-bottom: 0; }
.ov-title { display: block; font-size: 28rpx; color: rgba(255,255,255,0.8); margin-bottom: 24rpx; }
.ov-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.ov-item { background: rgba(255,255,255,0.15); border-radius: 16rpx; padding: 24rpx; text-align: center; }
.ov-num { display: block; font-size: 48rpx; font-weight: 500; color: #fff; margin-bottom: 8rpx; }
.ov-label { font-size: 24rpx; color: rgba(255,255,255,0.7); }
.dist-item { margin-bottom: 20rpx; display: flex; align-items: center; gap: 16rpx; }
.dist-bar-wrap { width: 260rpx; height: 24rpx; background: #F5F7FA; border-radius: 12rpx; overflow: hidden; flex-shrink: 0; }
.dist-bar { height: 100%; border-radius: 12rpx; transition: width 0.3s; }
.dist-label { width: 80rpx; font-size: 24rpx; color: #5F5E5A; flex-shrink: 0; }
.dist-val { font-size: 24rpx; color: #8A9BB0; }
.avg-time-row { display: flex; align-items: baseline; gap: 12rpx; }
.avg-time-num { font-size: 72rpx; font-weight: 500; color: #1D9E75; }
.avg-time-unit { font-size: 30rpx; color: #5F5E5A; }
.avg-time-hint { font-size: 26rpx; color: #8A9BB0; margin-left: 16rpx; }

/* 悬浮操作栏 */
.float-action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
}
.fab-switch {
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
}
.fab-logout {
  background: #E24B4A;
}
.fab-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.fab-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
  text-align: center;
}
