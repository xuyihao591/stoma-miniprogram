/* pages/doctor/detail/detail.wxss */
.detail-page { background: #F5F7FA; }

.patient-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pb-left { display: flex; align-items: center; gap: 20rpx; }

.pb-avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 40rpx;
  background: #E1F5EE;
}

.pb-name { display: block; font-size: 30rpx; font-weight: 500; color: #1A2332; }
.pb-meta { display: block; font-size: 24rpx; color: #8A9BB0; margin-top: 4rpx; }
.history-link { font-size: 26rpx; color: #1D9E75; }

.media-scroll-h { white-space: nowrap; margin-bottom: 20rpx; }

.media-row { display: flex; gap: 16rpx; }

.media-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.detail-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 16rpx;
  background: #E6F1FB;
}

.detail-video {
  width: 320rpx;
  height: 240rpx;
  border-radius: 16rpx;
}

.media-tag {
  font-size: 22rpx;
  color: #8A9BB0;
  margin-top: 8rpx;
}

.model3d-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #111820;
  border-radius: 16rpx;
  padding: 24rpx;
}

.model3d-entry.disabled { opacity: 0.5; }

.model3d-icon {
  width: 64rpx;
  height: 64rpx;
  background: #1D9E75;
  border-radius: 12rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.model3d-title { display: block; font-size: 28rpx; font-weight: 500; color: #9FE1CB; }
.model3d-sub { display: block; font-size: 23rpx; color: rgba(255,255,255,0.5); margin-top: 4rpx; }

.mini-spinner {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid rgba(29,158,117,0.3);
  border-top-color: #1D9E75;
  border-radius: 16rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.arrow-icon { font-size: 36rpx; color: #9FE1CB; margin-left: auto; }

.ai-label {
  margin-left: auto;
  background: #E6F1FB;
  color: #185FA5;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.metric-item { background: #F5F7FA; border-radius: 16rpx; padding: 16rpx 20rpx; }
.metric-label { display: block; font-size: 24rpx; color: #8A9BB0; margin-bottom: 6rpx; }
.metric-val-row { display: flex; align-items: baseline; gap: 4rpx; margin-bottom: 4rpx; }
.metric-value { font-size: 34rpx; font-weight: 500; color: #1A2332; }
.v-red { color: #E24B4A; }
.metric-unit { font-size: 22rpx; color: #8A9BB0; }
.metric-ref { font-size: 22rpx; color: #B4B2A9; }

.symptom-box {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.7;
}

.ai-conclusion {
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.8;
  background: #F5F7FA;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.severity-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sr-label { font-size: 26rpx; color: #5F5E5A; }

.review-cta { padding: 24rpx; }

.btn-review {
  width: 100%;
  height: 96rpx;
  background: #1D9E75;
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-review::after { border: none; }

/* 悬浮操作栏 */
.float-action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
}
.fab-switch {
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
}
.fab-logout {
  background: #E24B4A;
}
.fab-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.fab-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
  text-align: center;
}
