/* pages/doctor/patients/patients.wxss */
.patients-page { background: #F5F7FA; min-height: 100vh; }
.page-header {
  display:flex; align-items:center; justify-content:space-between;
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
  padding: 20rpx 32rpx 28rpx;
}
.header-title { color:#fff; font-size:36rpx; font-weight:700; }
.header-profile-btn {
  width:72rpx; height:72rpx; border-radius:50%;
  overflow:hidden; border:3rpx solid rgba(255,255,255,0.5);
}
.header-avatar { width:100%; height:100%; }

/* 悬浮操作栏 */
.float-action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  background: #fff;
}
.fab-switch {
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
}
.fab-logout {
  background: #E24B4A;
}
.fab-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.fab-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
  text-align: center;
}

.search-bar-wrap { padding: 16rpx 24rpx; background: #fff; border-bottom: 1px solid rgba(29,158,117,0.1); }
.search-input { height: 72rpx; background: #F5F7FA; border-radius: 36rpx; padding: 0 28rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.patient-card { background: #fff; margin: 16rpx 24rpx 0; border-radius: 20rpx; padding: 24rpx; display: flex; align-items: center; gap: 20rpx; }
.pc-avatar { width: 80rpx; height: 80rpx; border-radius: 40rpx; background: #E1F5EE; flex-shrink: 0; }
.pc-body { flex: 1; }
.pc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.pc-name { font-size: 30rpx; font-weight: 500; color: #1A2332; }
.pc-meta { display: block; font-size: 24rpx; color: #8A9BB0; margin-bottom: 4rpx; }
.pc-last { display: block; font-size: 23rpx; color: #B4B2A9; }
.pc-arrow { font-size: 36rpx; color: #B4B2A9; }
