/* pages/doctor/model3d/model3d.wxss */
.model3d-page {
  background: #111820;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.model-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #111820;
}

.ml-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(29,158,117,0.3);
  border-top-color: #1D9E75;
  border-radius: 40rpx;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.ml-text {
  font-size: 30rpx;
  color: #9FE1CB;
  margin-bottom: 8rpx;
}

.ml-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

.model-container {
  position: relative;
  flex: 1;
  height: calc(100vh - 200rpx);
  overflow: hidden;
  background: #1A2840;
}

.hidden { opacity: 0; pointer-events: none; }

/* 控制叠层 */
.controls-overlay {
  position: absolute;
  top: 0; left: 0; right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx;
  pointer-events: none;
}

.view-presets {
  display: flex;
  gap: 12rpx;
  pointer-events: all;
}

.preset-btn {
  height: 56rpx;
  padding: 0 24rpx;
  background: rgba(0,0,0,0.5);
  color: rgba(255,255,255,0.8);
  border-radius: 28rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.preset-btn.active {
  background: rgba(29,158,117,0.8);
  border-color: #1D9E75;
  color: #fff;
}

.tools-right {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  pointer-events: all;
}

.tool-btn {
  width: 80rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 16rpx;
  padding: 10rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.tool-active {
  background: rgba(29,158,117,0.6);
  border-color: #1D9E75;
}

.tool-icon { font-size: 28rpx; }
.tool-label { font-size: 18rpx; color: rgba(255,255,255,0.7); margin-top: 4rpx; }

/* 测量叠层 */
.measure-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
}

.measure-hint {
  background: rgba(0,0,0,0.6);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.measure-result {
  background: rgba(29,158,117,0.8);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 底部指标 */
.bottom-metrics {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0,0,0,0.6);
  padding: 16rpx;
}

.metrics-scroll { white-space: nowrap; }

.metrics-inner {
  display: flex;
  gap: 12rpx;
}

.m-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid #1D9E75;
  min-width: 120rpx;
  flex-shrink: 0;
}

.m-chip-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 6rpx;
}

.m-chip-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #9FE1CB;
}

.v-red { color: #F09595; }

/* 底部面板 */
.info-panel {
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}

.ip-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ip-patient {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2332;
}

.ip-date {
  font-size: 24rpx;
  color: #8A9BB0;
}

.ip-buttons {
  display: flex;
  gap: 16rpx;
}

.ip-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.ip-btn-secondary {
  background: #E1F5EE;
  color: #0F6E56;
}

.ip-btn-primary {
  background: #1D9E75;
  color: #fff;
}

.ip-btn-primary::after { border: none; }
.ip-btn-secondary::after { border: none; }

/* 悬浮操作栏 */
.float-action-bar {
  position: fixed;
  right: 24rpx;
  bottom: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}
.fab-switch {
  background: linear-gradient(135deg, #0F6E56 0%, #0A5C45 100%);
}
.fab-logout {
  background: #E24B4A;
}
.fab-icon { font-size: 32rpx; margin-bottom: 2rpx; }
.fab-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
  text-align: center;
}
